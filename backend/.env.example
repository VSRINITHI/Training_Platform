# Supabase Configuration
# SUPABASE_URL is used for modern ECC P-256 (ES256) JWKS verification via /.well-known/jwks.json
SUPABASE_URL=https://your-project-id.supabase.co

# Optional: Supabase Project JWT Secret (only needed if verifying legacy HS256 tokens)
# Modern Supabase projects use ES256 public key JWKS verification and do not require this secret.
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret-if-using-legacy-hs256

# Optional: Supabase service role key (for administrative backend operations)
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# PostgreSQL Connection String (Transaction Pooler / Direct)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
